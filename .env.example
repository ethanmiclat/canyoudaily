# Set these in the Vercel project (Settings → Environment Variables). Local dev works without them.

# Can You Survive: HMAC secret for the daily typed-round picks. Required in production.
SERVER_SECRET=
# Can You Remember: secret for daily seeds. Required in production.
CYR_SECRET=
# Can You Remember: protects /api/remember/admin (score exports).
ADMIN_TOKEN=

# Upstash Redis, shared by every game (keys are prefixed per game). Without it scores live in memory
# and are lost on cold starts. The Vercel Upstash integration sets KV_REST_API_URL/KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
