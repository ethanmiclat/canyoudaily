{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/survive.ts": {
      "includeFiles": "imported/survive/server/content/**"
    },
    "api/compare.ts": {
      "includeFiles": "imported/compare/server/content/**"
    },
    "api/remember.ts": {
      "includeFiles": "imported/remember/server/content/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/survive/:route*",
      "destination": "/api/survive?__route=:route*"
    },
    {
      "source": "/api/compare/:route*",
      "destination": "/api/compare?__route=:route*"
    },
    {
      "source": "/api/remember/:route*",
      "destination": "/api/remember?__route=:route*"
    },
    {
      "source": "/survive",
      "destination": "/survive/index.html"
    },
    {
      "source": "/survive/:path*",
      "destination": "/survive/index.html"
    },
    {
      "source": "/compare",
      "destination": "/compare/index.html"
    },
    {
      "source": "/compare/:path*",
      "destination": "/compare/index.html"
    },
    {
      "source": "/remember",
      "destination": "/remember/index.html"
    },
    {
      "source": "/remember/:path*",
      "destination": "/remember/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
