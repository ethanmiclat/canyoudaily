{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/survive/**/*.ts": {
      "includeFiles": "imported/survive/server/content/**"
    },
    "api/remember/**/*.ts": {
      "includeFiles": "imported/remember/server/content/**"
    }
  },
  "rewrites": [
    {
      "source": "/survive",
      "destination": "/survive/index.html"
    },
    {
      "source": "/survive/:path*",
      "destination": "/survive/index.html"
    },
    {
      "source": "/remember",
      "destination": "/remember/index.html"
    },
    {
      "source": "/remember/:path*",
      "destination": "/remember/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
